# =====================================================================
# ABITDA - Autonomous Options Agent Configuration
# =====================================================================

# Alpaca API Credentials (Paper or Live)
# Get your keys at: https://app.alpaca.markets
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Google Gemini API Key (for Multi-Agent Committee Deliberation)
# Get your key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Execution Mode (set to true to execute live orders on Alpaca)
LIVE_BROKER_EXECUTION=false

# Risk Limits
MAX_PORTFOLIO_DELTA=0.25
MAX_PORTFOLIO_VEGA=150.0
MAX_CAPITAL_PER_TRADE_PCT=0.05
DAILY_DRAWDOWN_LIMIT_PCT=0.03
